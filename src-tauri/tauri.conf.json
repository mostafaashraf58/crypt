{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom Workstation",
  "version": "0.1.0",
  "identifier": "com.axiom.workstation",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Axiom Workstation",
        "width": 1540,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 720,
        "backgroundColor": "#0D0E12",
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/axiom-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Private, local AI-ready trading workstation",
    "category": "Finance",
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": true},
      "nsis": {"installMode": "currentUser", "displayLanguageSelector": false, "languages": ["English"]}
    }
  }
}
